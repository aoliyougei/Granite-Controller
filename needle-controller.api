syntax = "v1"

info(
  title: "Needle OpenAI Tool Calling Service"
  desc: "OpenAI-compatible tool selection backed by an embedded Needle engine; tools are never executed"
  version: "0.2.0"
)

type HealthResponse {
  Status string `json:"status"`
}

type ReadyResponse {
  Status string `json:"status"`
  Model string `json:"model"`
}

type Model {
  ID string `json:"id"`
  Object string `json:"object"`
  Created int64 `json:"created"`
  OwnedBy string `json:"owned_by"`
}

type ModelListResponse {
  Object string `json:"object"`
  Data []Model `json:"data"`
}

// Chat Completions uses dynamic OpenAI messages/tools JSON. Runtime structs in
// internal/openai are authoritative because goctl cannot express arbitrary
// validated JSON Schemas.
type ChatCompletionRequest {}
type ChatCompletionResponse {}

@server(group: public)
service needle-controller {
  @handler Health
  get /healthz returns (HealthResponse)

  @handler Ready
  get /readyz returns (ReadyResponse)
}

@server(group: openai)
service needle-controller {
  @handler Models
  get /v1/models returns (ModelListResponse)

  @handler ChatCompletions
  post /v1/chat/completions (ChatCompletionRequest) returns (ChatCompletionResponse)
}
