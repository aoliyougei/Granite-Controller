# Copy to .env and replace placeholders. Never commit a populated .env.
CONTROLLER_PORT=8080
CONTROLLER_API_TOKEN=replace-with-a-long-random-controller-token

NEEDLE_BASE_URL=http://needle-openai.example:8000
# Leave empty only when needle-openai authentication is disabled.
NEEDLE_API_KEY=
NEEDLE_MODEL_ID=needle-2
NEEDLE_MIN_CONFIDENCE=0.6
NEEDLE_TIMEOUT=120s
NEEDLE_MAX_TOKENS=256
CONTROLLER_MAX_MESSAGE_LENGTH=512

INFRA_CONTROL_BASE_URL=http://infrastructure-control.example:8080
INFRA_CONTROL_API_TOKEN=replace-with-the-infrastructure-control-token
INFRA_CONTROL_TIMEOUT=30s
